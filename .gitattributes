# Default: normalise line endings on checkout
* text=auto

# Shell scripts must always use LF — they run on Linux
*.sh text eol=lf

# C++ source (arrives at T1)
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf

# CMake (arrives at T1)
CMakeLists.txt text eol=lf
*.cmake        text eol=lf

# Python
*.py    text eol=lf
*.toml  text eol=lf

# Data and documents
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
