# What the tracked files already do, stated for editors. Every property below
# was measured on the files it applies to before it was written here; none is a
# rule the files were changed to meet.

root = true

# Every tracked file: UTF-8 without a byte-order mark, ending in a newline, and
# indented with spaces (no tracked file contains a tab).
[*]
charset = utf-8
insert_final_newline = true
indent_style = space

# Block indentation is four spaces. Continuation lines are aligned to what they
# continue rather than to the unit, which an editor's indent size does not
# decide. `.gitattributes` keeps every type here at LF.
[*.{cpp,hpp,h,py,sh,toml,cmake}]
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true

[CMakeLists.txt]
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true

[*.{yml,json}]
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true

[*.{js,mjs}]
indent_size = 2
trim_trailing_whitespace = true

[*.md]
end_of_line = lf
trim_trailing_whitespace = true

# Vendored single headers stay byte for byte as upstream wrote them, and
# doctest.h has a line with trailing whitespace.
[third_party/{doctest,nlohmann}/**]
trim_trailing_whitespace = false
